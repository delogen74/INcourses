[Unit]
Description=Bot Platform Celery Worker
After=network.target redis.service

[Service]
User=botplatform
Group=botplatform
WorkingDirectory=/srv/bot_platform
EnvironmentFile=/srv/bot_platform/.env
ExecStart=/srv/bot_platform/.venv/bin/celery -A core worker -l info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
